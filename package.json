{
  "name": "dsh-wechat-workbench",
  "version": "0.1.0",
  "description": "WeChat remote workbench for DeepSeek Harness: browse workspaces, continue sessions, and approve agent questions over the iLink Bot long connection",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./client/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "client",
    "python",
    "scripts",
    "tests",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test 'tests/*.test.mjs'",
    "setup:python": "bash scripts/setup-python.sh"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "wechat",
    "weixin",
    "wechat-agent",
    "ilink",
    "agent",
    "remote"
  ],
  "author": "dsh-wechat-workbench contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maitutudad/dsh-wechat-workbench.git"
  },
  "bugs": {
    "url": "https://github.com/maitutudad/dsh-wechat-workbench/issues"
  },
  "homepage": "https://github.com/maitutudad/dsh-wechat-workbench#readme",
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-api-session-controller": "*",
    "@deepseek-ai/dsh-api-workspace-controller": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/dsh-user-questions": "*",
    "@deepseek-ai/schemastery": "*"
  }
}
